---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
    variant?: "sidebar" | "mobile";
}

const { headings = [], variant = "sidebar" } = Astro.props;

// Filter to depths 2-4 (sections and subsections)
const filteredHeadings = headings.filter(
    (h) => h.depth >= 2 && h.depth <= 4,
);

const minDepth =
    filteredHeadings.length > 0
        ? Math.min(...filteredHeadings.map((h) => h.depth))
        : 2;

const initialSectionTitle = filteredHeadings[0]?.text ?? "Overview";
---

{
    filteredHeadings.length > 0 && variant === "sidebar" && (
        <nav class="toc-sidebar" aria-label="Table of contents">
            <p class="toc-title label">Sections</p>
            <ul class="toc-list">
                {filteredHeadings.map((heading) => {
                    const level = heading.depth - minDepth;
                    return (
                        <li
                            class={`toc-item level-${level}`}
                            data-depth={heading.depth}
                        >
                            <a
                                href={`#${heading.slug}`}
                                class="toc-link"
                                data-slug={heading.slug}
                            >
                                {heading.text}
                            </a>
                        </li>
                    );
                })}
            </ul>
        </nav>
    )
}

{
    filteredHeadings.length > 0 && variant === "mobile" && (
        <details class="mobile-toc">
            <summary class="mobile-toc-summary">
                <span class="mobile-toc-label-group">
                    <span class="label">Sections</span>
                    <span class="mobile-active-section-preview" aria-live="polite">
                        {initialSectionTitle}
                    </span>
                </span>
                <span class="mobile-toc-chevron" aria-hidden="true">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </span>
            </summary>
            <div class="mobile-toc-body">
                <ul class="toc-list">
                    {filteredHeadings.map((heading) => {
                        const level = heading.depth - minDepth;
                        return (
                            <li
                                class={`toc-item level-${level}`}
                                data-depth={heading.depth}
                            >
                                <a
                                    href={`#${heading.slug}`}
                                    class="toc-link"
                                    data-slug={heading.slug}
                                >
                                    {heading.text}
                                </a>
                            </li>
                        );
                    })}
                </ul>
            </div>
        </details>
    )
}

<script>
    function initScrollspy() {
        const links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>(".toc-link"),
        );
        if (links.length === 0) return;

        const uniqueSlugs = Array.from(
            new Set(
                links
                    .map((l) => l.getAttribute("data-slug"))
                    .filter((slug): slug is string => Boolean(slug)),
            ),
        );

        const headingElements = uniqueSlugs
            .map((slug) => document.getElementById(slug))
            .filter((el): el is HTMLElement => el !== null);

        if (headingElements.length === 0) return;

        let activeSlug: string | null = null;

        function setActive(slug: string | null) {
            if (!slug || slug === activeSlug) return;
            activeSlug = slug;

            for (const link of links) {
                const isMatch = link.getAttribute("data-slug") === slug;
                link.classList.toggle("is-active", isMatch);
                if (isMatch) {
                    link.setAttribute("aria-current", "true");

                    // Update mobile preview text
                    const preview = document.querySelector(
                        ".mobile-active-section-preview",
                    );
                    if (preview && link.textContent) {
                        preview.textContent = link.textContent.trim();
                    }
                } else {
                    link.removeAttribute("aria-current");
                }
            }
        }

        // Smooth scroll and immediate active state on click
        for (const link of links) {
            link.addEventListener("click", (e) => {
                const slug = link.getAttribute("data-slug");
                if (!slug) return;
                const target = document.getElementById(slug);
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: "smooth" });
                    setActive(slug);
                    history.pushState(null, "", `#${slug}`);

                    // Close mobile dropdown if open
                    const details = link.closest("details");
                    if (details) {
                        details.removeAttribute("open");
                    }
                }
            });
        }

        let ticking = false;

        function updateScroll() {
            // Check if near page bottom
            const isBottom =
                window.innerHeight + window.scrollY >=
                document.documentElement.scrollHeight - 50;

            if (isBottom) {
                const last = headingElements[headingElements.length - 1];
                if (last) setActive(last.id);
                return;
            }

            const threshold = 120;
            let current: HTMLElement | null = null;

            for (const el of headingElements) {
                const rect = el.getBoundingClientRect();
                if (rect.top <= threshold) {
                    current = el;
                } else {
                    break;
                }
            }

            if (current) {
                setActive(current.id);
            } else if (window.scrollY < 100 && headingElements.length > 0) {
                setActive(headingElements[0].id);
            }
        }

        function onScroll() {
            if (!ticking) {
                requestAnimationFrame(() => {
                    updateScroll();
                    ticking = false;
                });
                ticking = true;
            }
        }

        window.addEventListener("scroll", onScroll, { passive: true });

        // Handle initial load / hash
        if (window.location.hash) {
            const hashSlug = decodeURIComponent(
                window.location.hash.replace(/^#/, ""),
            );
            if (uniqueSlugs.includes(hashSlug)) {
                setActive(hashSlug);
            } else {
                updateScroll();
            }
        } else {
            updateScroll();
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initScrollspy);
    } else {
        initScrollspy();
    }
</script>

<style>
    .toc-title {
        margin: 0 0 var(--space-2);
        color: var(--ink-muted);
    }

    .toc-list {
        list-style: none;
        margin: 0;
        padding: 0;
        border-left: 1px solid var(--rule);
        display: flex;
        flex-direction: column;
    }

    .toc-item {
        margin: 0;
        padding: 0;
    }

    .toc-link {
        display: block;
        font-family: var(--font-mono);
        color: var(--ink-muted);
        text-decoration: none;
        border-left: 2px solid transparent;
        margin-left: -1px;
        padding-top: 0.35rem;
        padding-bottom: 0.35rem;
        padding-right: 0.5rem;
        line-height: 1.35;
        transition:
            color 0.15s ease,
            border-color 0.15s ease,
            background-color 0.15s ease;
        border-radius: 0 3px 3px 0;
        word-break: break-word;
    }

    /* Hierarchy indentation */
    .toc-item.level-0 .toc-link {
        padding-left: 0.75rem;
        font-size: 0.8125rem;
        font-weight: 500;
    }

    .toc-item.level-1 .toc-link {
        padding-left: 1.5rem;
        font-size: 0.75rem;
    }

    .toc-item.level-2 .toc-link {
        padding-left: 2.25rem;
        font-size: 0.7rem;
    }

    .toc-link:hover {
        color: var(--oxblood);
    }

    .toc-link.is-active {
        color: var(--ochre-deep);
        border-left-color: var(--ochre-deep);
        background: rgba(185, 122, 18, 0.08);
        font-weight: 500;
    }

    /* Mobile Accordion Style */
    .mobile-toc {
        border: 1px solid var(--rule);
        border-radius: 4px;
        background: var(--paper);
        margin: 0;
        padding: 0.5rem 0.75rem;
        box-shadow: 0 2px 8px rgba(42, 42, 51, 0.04);
    }

    .mobile-toc-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        user-select: none;
        list-style: none;
        gap: var(--space-2);
    }

    .mobile-toc-summary::-webkit-details-marker {
        display: none;
    }

    .mobile-toc-label-group {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        min-width: 0;
        overflow: hidden;
    }

    .mobile-active-section-preview {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding-left: var(--space-2);
        border-left: 1px solid var(--rule);
    }

    .mobile-toc-chevron {
        display: inline-flex;
        align-items: center;
        color: var(--ink-muted);
        transition: transform 0.2s ease;
        flex-shrink: 0;
    }

    .mobile-toc[open] .mobile-toc-chevron {
        transform: rotate(180deg);
    }

    .mobile-toc-body {
        margin-top: var(--space-2);
        padding-top: var(--space-2);
        border-top: 1px solid var(--rule);
        max-height: 60vh;
        overflow-y: auto;
    }
</style>
