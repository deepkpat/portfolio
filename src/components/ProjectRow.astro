---
interface Props {
    title: string;
    summary: string;
    tags: string[];
    year: number | string;
    href: string;
}

const { title, summary, tags, year, href } = Astro.props;
---

<li class="project-row">
    <a class="project-link" href={href}>
        <div class="project-head">
            <h3>{title}</h3>
            <span class="project-year">{year}</span>
        </div>
        <p class="project-summary">{summary}</p>
        {tags.length > 0 && (
            <ul class="project-tags" aria-label="Tags">
                {tags.map((tag) => (
                    <li class="tag">{tag}</li>
                ))}
            </ul>
        )}
    </a>
</li>

<style>
    .project-row {
        border-bottom: 1px solid var(--rule);
    }

    .project-link {
        display: block;
        padding: var(--space-3) 0;
        color: var(--ink);
        text-decoration: none;
    }

    .project-link:hover {
        color: var(--ink);
    }

    .project-head {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: baseline;
        gap: var(--space-2);
    }

    .project-head h3 {
        margin: 0;
        font-size: var(--text-h3);
    }

    .project-link:hover h3 {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .project-year {
        color: var(--ink-muted);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        text-align: right;
    }

    .project-summary {
        margin: var(--space-1) 0 0;
        color: var(--ink-muted);
        max-width: var(--measure);
    }

    .project-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1);
        list-style: none;
        margin: var(--space-2) 0 0;
        padding: 0;
    }

    @media (max-width: 40rem) {
        .project-head {
            grid-template-columns: 1fr;
            gap: 0.25rem;
        }

        .project-year {
            text-align: left;
        }
    }
</style>
