---
interface Props {
    title: string;
    summary?: string;
    date: Date;
    tags?: string[];
    href: string;
}

const { title, summary, date, tags = [], href } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
});
---

<li class="post-row">
    <a class="post-link" href={href}>
        <div class="post-head">
            <h3>{title}</h3>
            <time datetime={date.toISOString()}>{formattedDate}</time>
        </div>
        {summary && <p class="post-summary">{summary}</p>}
        {tags.length > 0 && (
            <ul class="post-tags" aria-label="Tags">
                {tags.map((tag) => (
                    <li class="tag">{tag}</li>
                ))}
            </ul>
        )}
    </a>
</li>

<style>
    .post-row {
        border-bottom: 1px solid var(--rule);
    }

    .post-link {
        display: block;
        padding: var(--space-3) 0;
        color: var(--ink);
        text-decoration: none;
    }

    .post-link:hover {
        color: var(--ink);
    }

    .post-head {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: baseline;
        gap: var(--space-2);
    }

    .post-head h3 {
        margin: 0;
        font-size: var(--text-h3);
    }

    .post-link:hover h3 {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .post-head time {
        color: var(--ink-muted);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        text-align: right;
    }

    .post-summary {
        margin: var(--space-1) 0 0;
        color: var(--ink-muted);
        max-width: var(--measure);
    }

    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1);
        list-style: none;
        margin: var(--space-2) 0 0;
        padding: 0;
    }

    @media (max-width: 40rem) {
        .post-head {
            grid-template-columns: 1fr;
            gap: 0.25rem;
        }

        .post-head time {
            text-align: left;
        }
    }
</style>
