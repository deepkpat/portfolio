---
import "katex/dist/katex.min.css";
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Props {
    title: string;
    description?: string;
    date?: Date;
    label?: string;
    year?: number | string;
    tags?: string[];
    backHref?: string;
    backLabel?: string;
    headings?: MarkdownHeading[];
}

const {
    title,
    description,
    date,
    label = "Writing",
    year,
    tags = [],
    backHref = "/blog",
    backLabel = "Back to writing",
    headings = [],
} = Astro.props;

const filteredHeadings = (headings || []).filter(
    (h) => h.depth >= 2 && h.depth <= 4,
);
const hasHeadings = filteredHeadings.length > 0;

const formattedDate = date?.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<BaseLayout
    title={`${title} — Deepkumar Patel`}
    description={description}
    wide={hasHeadings}
>
    <div class:list={["post-layout", { "has-sidebar": hasHeadings }]}>
        {hasHeadings && (
            <aside class="post-sidebar" aria-label="Page navigation">
                <div class="sidebar-sticky">
                    <a href={backHref} class="sidebar-back-link">
                        <span aria-hidden="true">&larr;</span> {backLabel}
                    </a>
                    <TableOfContents
                        headings={filteredHeadings}
                        variant="sidebar"
                    />
                </div>
            </aside>
        )}

        <article class="post-main">
            <header class="post-header">
                <p class="label">{label}</p>
                <h1>{title}</h1>
                {(date || year || tags.length > 0) && (
                    <div class="meta">
                        {date && (
                            <time datetime={date.toISOString()}>
                                {formattedDate}
                            </time>
                        )}
                        {year && <span class="year">{year}</span>}
                        {tags.length > 0 && (
                            <ul class="tags" aria-label="Tags">
                                {tags.map((tag) => (
                                    <li class="tag">{tag}</li>
                                ))}
                            </ul>
                        )}
                    </div>
                )}
                {description && <p class="lead">{description}</p>}
            </header>

            {hasHeadings && (
                <div class="mobile-toc-container">
                    <TableOfContents
                        headings={filteredHeadings}
                        variant="mobile"
                    />
                </div>
            )}

            <div class="prose">
                <slot />
            </div>

            <footer class="post-footer">
                <a href={backHref}>{backLabel}</a>
            </footer>
        </article>
    </div>
</BaseLayout>

<script>
    import mermaid from "mermaid";

    mermaid.initialize({
        startOnLoad: false,
        theme: "base",
        fontFamily: '"JetBrains Mono", ui-monospace, monospace',
        themeVariables: {
            background: "#F1EDE4",
            primaryColor: "#F1EDE4",
            primaryTextColor: "#2A2A33",
            primaryBorderColor: "#8F5B06",
            lineColor: "#6A6760",
            secondaryColor: "#B97A12",
            tertiaryColor: "#CFC8B8",
            mainBkg: "#F1EDE4",
            nodeBorder: "#8F5B06",
            clusterBkg: "#F1EDE4",
            clusterBorder: "#CFC8B8",
            titleColor: "#2A2A33",
            edgeLabelBackground: "#F1EDE4",
        },
    });

    const blocks = document.querySelectorAll("pre > code.language-mermaid");

    for (const block of blocks) {
        const diagram = document.createElement("div");
        diagram.className = "mermaid";
        diagram.textContent = block.textContent ?? "";
        block.parentElement?.replaceWith(diagram);
    }

    await mermaid.run({ querySelector: ".mermaid" });
</script>

<style>
    .post-layout {
        width: 100%;
    }

    .post-main {
        max-width: var(--measure);
        margin-inline: auto;
    }

    .post-sidebar {
        display: none;
    }

    /* Mobile sticky TOC bar */
    .mobile-toc-container {
        display: block;
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--paper);
        padding: var(--space-2) 0;
        margin-bottom: var(--space-4);
    }

    @media (min-width: 54rem) {
        .post-layout.has-sidebar {
            display: grid;
            grid-template-columns: minmax(12rem, 14.5rem) minmax(
                    0,
                    var(--measure)
                );
            justify-content: center;
            column-gap: var(--space-4);
        }

        .post-layout.has-sidebar .post-main {
            margin-inline: 0;
            width: 100%;
        }

        .post-layout.has-sidebar .post-sidebar {
            display: block;
            height: 100%;
        }

        .post-layout.has-sidebar .mobile-toc-container {
            display: none;
        }
    }

    .sidebar-sticky {
        position: sticky;
        top: var(--space-5);
        max-height: calc(100vh - var(--space-5) - var(--space-3));
        overflow-y: auto;
        padding-right: var(--space-2);
        scrollbar-width: thin;
        scrollbar-color: var(--rule) transparent;
    }

    .sidebar-back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--ink-muted);
        text-decoration: none;
        margin-bottom: var(--space-4);
        transition: color 0.15s ease;
    }

    .sidebar-back-link:hover {
        color: var(--oxblood);
    }

    .post-header {
        margin-bottom: var(--space-5);
    }

    .post-header h1 {
        margin: 0 0 var(--space-2);
    }

    .post-header .label {
        margin: 0 0 var(--space-2);
    }

    .post-header .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-1) var(--space-2);
    }

    .post-header time,
    .post-header .year {
        color: var(--ink-muted);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
    }

    .post-header .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .post-header .lead {
        margin: var(--space-2) 0 0;
    }

    .post-footer {
        margin-top: var(--space-5);
        padding-top: var(--space-2);
        border-top: 1px solid var(--rule);
    }
</style>

<style is:global>
    .prose > :first-child {
        margin-top: 0;
    }

    .prose h2,
    .prose h3,
    .prose h4 {
        scroll-margin-top: 3.5rem;
    }

    .prose p,
    .prose ul,
    .prose ol,
    .prose blockquote {
        max-width: var(--measure);
    }

    .prose ul,
    .prose ol {
        padding-left: 1.25rem;
    }

    .prose li {
        margin-bottom: var(--space-1);
    }

    .prose blockquote {
        margin: var(--space-4) 0;
        padding-left: var(--space-2);
        border-left: 2px solid var(--ochre);
        color: var(--ink-muted);
        font-style: italic;
    }

    .prose blockquote p {
        margin-bottom: 0;
    }

    .prose img {
        max-width: 100%;
        height: auto;
    }

    .prose table {
        width: 100%;
        border-collapse: collapse;
        margin: var(--space-4) 0;
        font-size: var(--text-sm);
    }

    .prose th,
    .prose td {
        padding: var(--space-1) var(--space-2);
        border-bottom: 1px solid var(--rule);
        text-align: left;
    }

    .prose th {
        font-family: var(--font-mono);
        font-weight: 500;
    }

    .prose .katex-display {
        margin: var(--space-4) 0;
        overflow-x: auto;
        overflow-y: hidden;
        padding: var(--space-1) 0;
    }

    .prose .mermaid {
        display: flex;
        justify-content: center;
        margin: var(--space-4) 0;
        padding: var(--space-2);
        overflow-x: auto;
        border: 1px solid var(--rule);
        border-radius: 4px;
        background: var(--paper);
    }

    .prose .mermaid svg {
        max-width: 100%;
        height: auto;
    }
</style>
