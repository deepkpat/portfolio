---
import BlogLayout from "./BlogLayout.astro";

interface Props {
    title: string;
    summary?: string;
    year: number | string;
    tags?: string[];
}

const { title, summary, year, tags = [] } = Astro.props;
---

<BlogLayout
    title={title}
    description={summary}
    label="Project"
    year={year}
    tags={tags}
    backHref="/projects"
    backLabel="Back to projects"
>
    <slot />
</BlogLayout>
