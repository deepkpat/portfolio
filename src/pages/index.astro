---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import PostRow from "../components/PostRow.astro";

const featuredProjects = (await getCollection("projects"))
    .filter((project) => !project.data.draft && project.data.featured)
    .sort(
        (a, b) =>
            b.data.priority - a.data.priority ||
            a.data.title.localeCompare(b.data.title),
    )
    .slice(0, 1);

const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 1);

const year = new Date().getFullYear();
---

<BaseLayout
    title="Deepkumar Patel — Systems / ML"
    description="Deepkumar Patel designs distributed systems and trains models that run on them."
>
    <header class="hero">
        <p class="label hero-label">Systems / ML</p>
        <h1>Deepkumar Patel</h1>
        <p class="lead">
            I design distributed systems and train models that run on them.
        </p>
        <nav class="hero-links" aria-label="Primary">
            <a href="https://github.com/your-handle">GitHub</a>
            <a href="https://www.linkedin.com/in/your-handle/">LinkedIn</a>
            <a href="mailto:you@example.com">Email</a>
        </nav>
        <a class="button" href="#projects">
            View work
        </a>
    </header>

    <section id="projects" class="section" aria-labelledby="projects-heading">
        <h2 id="projects-heading">Projects</h2>
        {featuredProjects.length > 0 ? (
            <ul class="rows">
                {featuredProjects.map((project) => (
                    <ProjectRow
                        title={project.data.title}
                        summary={project.data.summary}
                        tags={project.data.tags}
                        year={project.data.year}
                        href={`/projects/${project.id}`}
                    />
                ))}
            </ul>
        ) : (
            <p class="empty">No featured projects yet.</p>
        )}
        <p class="all-link">
            <a href="/projects">All projects</a>
        </p>
    </section>

    <section id="writing" class="section" aria-labelledby="writing-heading">
        <h2 id="writing-heading">Writing</h2>
        {posts.length > 0 ? (
            <ul class="rows">
                {posts.map((post) => (
                    <PostRow
                        title={post.data.title}
                        summary={post.data.summary ?? post.data.description}
                        date={post.data.date}
                        href={`/blog/${post.id}`}
                    />
                ))}
            </ul>
        ) : (
            <p class="empty">No posts yet.</p>
        )}
        <p class="all-link">
            <a href="/blog">All posts</a>
        </p>
    </section>

    <section id="about" class="section" aria-labelledby="about-heading">
        <h2 id="about-heading">About</h2>
        <p>
            I design distributed systems and train models that run on them.
            [ABOUT TEXT — replace with two or three sentences in your voice.]
        </p>
    </section>

    <section id="contact" class="section" aria-labelledby="contact-heading">
        <h2 id="contact-heading">Contact</h2>
        <p>
            Open to [roles / collaboration / conversation]. The best way to
            reach me is at <a href="mailto:you@example.com">you@example.com</a>.
        </p>
    </section>

    <footer class="site-footer container" slot="footer">
        <nav aria-label="Footer">
            <a href="https://github.com/your-handle">GitHub</a>
            <a href="https://www.linkedin.com/in/your-handle/">LinkedIn</a>
        </nav>
        <p>© {year} Deepkumar Patel</p>
    </footer>
</BaseLayout>

<style>
    .hero {
        position: relative;
        isolation: isolate;
        padding-block: var(--space-4);
    }

    .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background-image:
            linear-gradient(var(--rule) 1px, transparent 1px),
            linear-gradient(90deg, var(--rule) 1px, transparent 1px);
        background-size: 32px 32px;
        opacity: 0.35;
        -webkit-mask-image: linear-gradient(
            to bottom,
            #000 0%,
            rgba(0, 0, 0, 0.5) 35%,
            transparent 70%
        );
        mask-image: linear-gradient(
            to bottom,
            #000 0%,
            rgba(0, 0, 0, 0.5) 35%,
            transparent 70%
        );
    }

    @media (max-width: 40rem) {
        .hero {
            padding-block: var(--space-3);
        }
    }

    .hero-label {
        margin: 0 0 calc(var(--space-2) + 0.625rem);
    }

    .hero h1 {
        margin: 0 0 var(--space-2);
    }

    .hero .lead {
        margin: 0;
    }

    .hero-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        margin-top: var(--space-3);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .hero .button {
        margin-top: var(--space-3);
    }

    .section {
        margin-top: var(--space-5);
        scroll-margin-top: var(--space-4);
    }

    .section h2 {
        margin-top: 0;
        padding-bottom: var(--space-1);
        border-bottom: 1px solid var(--rule);
    }

    .rows {
        list-style: none;
        margin: var(--space-3) 0 0;
        padding: 0;
    }

    .empty {
        color: var(--ink-muted);
        margin-top: var(--space-2);
    }

    .all-link {
        margin-top: var(--space-3);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .site-footer.container {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-2);
        padding-top: var(--space-4);
        padding-bottom: var(--space-3);
        border-top: 1px solid var(--rule);
    }

    .site-footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .site-footer p {
        margin: 0;
        color: var(--ink-muted);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
    }
</style>
