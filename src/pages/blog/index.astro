---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
    title="Writing — Deepkumar Patel"
    description="Notes on distributed systems, performance, and whatever else catches my attention."
>
    <header>
        <p class="label">Writing</p>
        <h1>Notes</h1>
        <p class="lead">Essays, working notes, and the occasional detour.</p>
    </header>

    {
        posts.length > 0 ? (
            <ul class="post-list">
                {posts.map((post) => (
                    <PostRow
                        title={post.data.title}
                        summary={post.data.summary ?? post.data.description}
                        date={post.data.date}
                        tags={post.data.tags}
                        href={`/blog/${post.id}`}
                    />
                ))}
            </ul>
        ) : (
            <p class="empty">No posts yet.</p>
        )
    }
</BaseLayout>

<style>
    header h1 {
        margin-top: 0;
    }

    .post-list {
        list-style: none;
        margin: var(--space-5) 0 0;
        padding: 0;
        border-top: 1px solid var(--rule);
    }

    .empty {
        color: var(--ink-muted);
        margin-top: var(--space-3);
    }
</style>
