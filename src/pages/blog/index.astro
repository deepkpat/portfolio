---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
    title="Writing — Deepkumar Patel"
    description="Notes on distributed systems, performance, and whatever else catches my attention."
>
    <header>
        <nav class="nav" aria-label="Breadcrumb">
            <a href="/" class="back-link">
                <span aria-hidden="true">&larr;</span> Back to home
            </a>
        </nav>
        <p class="label">Writing</p>
        <h1>Notes</h1>
        <p class="lead">Essays, working notes, and the occasional detour.</p>
    </header>

    {
        posts.length > 0 ? (
            <ul class="post-list">
                {posts.map((post) => (
                    <PostRow
                        title={post.data.title}
                        summary={post.data.summary ?? post.data.description}
                        date={post.data.date}
                        tags={post.data.tags}
                        href={`/blog/${post.id}`}
                    />
                ))}
            </ul>
        ) : (
            <p class="empty">No posts yet.</p>
        )
    }

    <footer class="page-footer">
        <a href="/" class="back-link">
            <span aria-hidden="true">&larr;</span> Back to home
        </a>
    </footer>
</BaseLayout>

<style>
    .nav {
        margin-bottom: var(--space-3);
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--ink-muted);
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .back-link:hover {
        color: var(--oxblood);
    }

    header h1 {
        margin-top: 0;
    }

    .post-list {
        list-style: none;
        margin: var(--space-5) 0 0;
        padding: 0;
        border-top: 1px solid var(--rule);
    }

    .empty {
        color: var(--ink-muted);
        margin-top: var(--space-3);
    }

    .page-footer {
        margin-top: var(--space-5);
        padding-top: var(--space-2);
        border-top: 1px solid var(--rule);
    }
</style>
